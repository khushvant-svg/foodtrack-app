# Copy this file's contents into your hosting platform's environment variables.
# Do not commit a real .env file with real secrets to git.

# A long random string. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-real-random-secret

# Your deployed frontend's URL (no trailing slash), so the backend accepts its requests.
FRONTEND_URL=https://your-frontend.vercel.app
